# ==============================================================================
# Sunveil Master API & Tunnel System — Environment Configuration Template
# NOTE: Copy this file to .env and configure your production secrets.
# NEVER commit the actual .env file to public GitHub!
# ==============================================================================

# Server Network Settings
PORT=8080
HTTP_PORT=8080
HOST=0.0.0.0
NODE_ENV=production

# Administrative Authentication (Master Secret for /admin portal)
MASTER_ADMIN_SECRET=generate_a_64_character_random_hex_secret_here
ADMIN_PANIC_KEY=generate_emergency_panic_unlock_key_here

# Cryptographic Signatures & Tokens
JWT_SECRET=generate_a_secure_jwt_signing_secret_here
CLIENT_SECRET=generate_svl_launcher_interop_secret_here

# External Integrations (Optional)
TEBEX_WEBHOOK_SECRET=your_tebex_webhook_secret_here

# Resource Limits & Security
MAX_FILE_SIZE_MB=150
RATE_LIMIT_MAX=100
DATA_DIR=./data
